{
  "expo": {
    "name": "RoadFit",
    "slug": "roadfit",
    "version": "3.0.0",
    "orientation": "portrait",
    "scheme": "roadfit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reel2reelaudio.roadfit"
    },
    "android": {
      "package": "com.reel2reelaudio.roadfit",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "baseUrl": "/RoadFit"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27aa61fb-88a8-40a6-942c-a21318a3e452"
      }
    },
    "owner": "reel2reel-audio"
  }
}
